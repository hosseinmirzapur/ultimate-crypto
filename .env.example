# Pulse environment configuration
# Copy to .env and fill in your API keys

# App
PULSE_ENV=development
PULSE_LOG_LEVEL=INFO
PULSE_DATA_RETENTION_DAYS=90
PULSE_DASHBOARD_REFRESH_MS=1000

# KuCoin
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=

# Toobit
TOOBIT_API_KEY=
TOOBIT_API_SECRET=

# Wallex
WALLEX_API_KEY=
WALLEX_API_SECRET=

# InfluxDB
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=hermes-token-please-change
INFLUXDB_ORG=hermes
INFLUXDB_BUCKET=market-data
